# Persistent data lives in /data (mount a volume there)
DATA_DIR=/data
# Set a long random value to enable POST /admin/sync and GET /admin/status
ADMIN_TOKEN=
# Source (defaults to the Origins keystone URL)
# FURNI_BASE_URL=https://images.habbo.com/habbo-origins/keystone/
# Be polite: confirm an acceptable rate with Sulake. Defaults are deliberately slow.
SYNC_USER_AGENT=furni-imager (contact: you@yourfansite.example)
SYNC_DELAY=0.3
SYNC_CONCURRENCY=2
SYNC_INTERVAL_HOURS=6
SYNC_ON_START=true
# Optional furnidata JSON for names / colour variants (class*N)
FURNIDATA_URL=
CORS_ORIGINS=*
PORT=8000
